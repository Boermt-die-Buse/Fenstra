#!/bin/bash
# Fenstra: Systemkennung (os-release) anwenden.
# Wird vom Paket fenstra-release nach der Installation und nach jedem Update von
# fedora-release-identity-* aufgerufen (RPM-Dateitrigger auf /usr/lib/os-release).
# Ehrlich gesagt: Die Datei /usr/lib/os-release gehört dem Fedora-Paket
# fedora-release-identity-kde-desktop. Wir überschreiben ihren Inhalt, damit die
# sichtbaren Namen "Fenstra" lauten, ID bleibt "fedora" (dnf, Anaconda-Profile
# und Skripte funktionieren weiter). "rpm -V fedora-release-identity-kde-desktop"
# meldet die Datei deshalb als geändert. Das ist beabsichtigt.
set -u
SRC=/usr/lib/fenstra/os-release
DST=/usr/lib/os-release
[ -f "$SRC" ] || exit 0
[ -e "$DST" ] || exit 0
# VERSION_ID und CPE aus der aktuellen Fedora-Kennung übernehmen, falls sie sich
# geändert haben (Systemupgrade auf eine neue Fedora-Version).
ver=$(sed -n 's/^VERSION_ID=//p' "$DST" | tr -d '"')
if [ -n "$ver" ]; then
  sed -e "s/^VERSION_ID=.*/VERSION_ID=$ver/" \
      -e "s/^VERSION=.*/VERSION=\"$ver (Fenstra Desktop)\"/" \
      -e "s/^PRETTY_NAME=.*/PRETTY_NAME=\"Fenstra $ver (basiert auf Fedora Linux)\"/" \
      -e "s|^CPE_NAME=.*|CPE_NAME=\"cpe:/o:fedoraproject:fedora:$ver\"|" \
      "$SRC" > "$DST.fenstra.tmp"
else
  cp "$SRC" "$DST.fenstra.tmp"
fi
if ! cmp -s "$DST.fenstra.tmp" "$DST"; then
  mv -f "$DST.fenstra.tmp" "$DST"
else
  rm -f "$DST.fenstra.tmp"
fi
exit 0
